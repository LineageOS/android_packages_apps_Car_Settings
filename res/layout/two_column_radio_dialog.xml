<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/DialogContainer">

        <LinearLayout style="@style/DialogMessageAndActionContainer">

            <TextView
                android:id="@+id/dialog_title"
                style="@style/DialogTitle" />

            <TextView
                android:id="@+id/dialog_message"
                style="@style/DialogMessageTextView" />

            <Button
                android:id="@+id/button_close"
                style="@style/DialogCloseButton"
                android:text="@string/dialog_close_button_text" />

            <Button
                android:id="@+id/button_apply"
                style="@style/DialogApplyButton"
                android:text="@string/dialog_apply_button_text" />

        </LinearLayout>

        <LinearLayout style="@style/DialogOptionsContainer">

            <RadioGroup
                android:id="@+id/dialog_radio_group"
                style="@style/DialogOptionsRadioGroup">
            </RadioGroup>

        </LinearLayout>

</LinearLayout>
