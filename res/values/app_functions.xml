<resources>
    <string name="invisible_screen_id" translatable="false">Invisible Screen</string>
    <string name="invisible_screen_hint" translatable="false">
        This screen includes important information about the state of the car, like its driving
        state, which may affect what AI agents or the user can do.
    </string>

    <string name="invisible_screen_driving_state_key" translatable="false">Driving State</string>
    <string name="invisible_screen_driving_state_purpose" translatable="false">
        Read only property that exposes the driving state of the car.
    </string>
    <string name="invisible_screen_driving_state_name" translatable="false">Driving State</string>
    <string name="invisible_screen_driving_state_hint" translatable="false">
        The possible Enum values are: DRIVING, PARKED.
        They may affect what AI agents or the user can do in the car.
    </string>

    <string name="invisible_screen_driving_state_values" translatable="false">
        {"type":"Enum", "values": [ "%1$s", "%2$s"]}</string>
    <string name="invisible_screen_driving_state_driving" translatable="false">DRIVING</string>
    <string name="invisible_screen_driving_state_parked" translatable="false">PARKED</string>


</resources>